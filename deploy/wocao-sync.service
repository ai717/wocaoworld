[Unit]
Description=wocao.world 订阅源同步（单次）
Documentation=file:/opt/wocao/README.md
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=wocao
Group=wocao
WorkingDirectory=/opt/wocao
ExecStart=/usr/bin/node --no-warnings=ExperimentalWarning /opt/wocao/src/cli.mjs sync
Environment=NODE_ENV=production

# 4 个源最坏情况约 1 分钟，源变多后默认的 90s 会被 systemd 掐掉
TimeoutStartSec=15min

# --- 最小权限加固，与 wocao-web 一致 ---
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=true
CapabilityBoundingSet=
ReadWritePaths=/opt/wocao/data
